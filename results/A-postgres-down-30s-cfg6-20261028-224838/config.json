{
  "scenario": {
    "name": "A-postgres-down-30s",
    "description": "toxiproxy proxy disabled (Postgres unreachable) for 30 seconds at 10 messages/s.",
    "rate": 10,
    "messageCount": null,
    "warmupSeconds": 30,
    "fault": {
      "kind": "proxy-disabled",
      "latencyMs": 0,
      "timeoutMs": 0,
      "errorRate": 0,
      "capacity": 0,
      "serviceTimeMs": 0
    },
    "faultStartSeconds": 0,
    "faultDurationSeconds": 30,
    "sendAfterFaultSeconds": 30,
    "drainTimeoutSeconds": 900,
    "rateChanges": [],
    "workerSwitches": null,
    "faultAppliedAt": 30,
    "faultRemovedAt": 60,
    "producerStopsAt": 90
  },
  "configuration": "6",
  "runner": {
    "producer": "http://localhost:5101",
    "worker": "http://localhost:5102",
    "ordersApi": "http://localhost:5103",
    "toxiproxy": "http://localhost:8474",
    "toxiproxyContainer": "external-toxiproxy",
    "serviceBus": "Endpoint=sb://localhost:5672;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=***;UseDevelopmentEmulator=true;",
    "serviceBusAdmin": "Endpoint=sb://localhost:5300;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=***;UseDevelopmentEmulator=true;",
    "queue": "orders",
    "proxy": "postgres"
  },
  "producer": {
    "service": "producer",
    "experiment": {
      "httpRetries": true,
      "dbRetries": true,
      "passCancellation": false,
      "alwaysThrow": false,
      "holdMessageMs": 0,
      "disableLockRenewal": false,
      "delayedRedelivery": true,
      "maxConcurrentCalls": 1,
      "maxDeliveryCount": 10
    },
    "images": {
      "PgWeb": "docker.io/sosedoff/pgweb:0.16.2",
      "Postgres": "docker.io/library/postgres:18.3",
      "ServiceBusEmulator": "mcr.microsoft.com/azure-messaging/servicebus-emulator:2.0.0",
      "ServiceBusEmulatorSql": "mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04",
      "Toxiproxy": "ghcr.io/shopify/toxiproxy:2.13.0"
    },
    "serviceBusRetry": {
      "mode": 1,
      "maxRetries": 3,
      "delay": "00:00:00.8000000",
      "maxDelay": "00:01:00",
      "tryTimeout": "00:01:00",
      "customRetryPolicy": null
    }
  },
  "worker": {
    "service": "worker",
    "experiment": {
      "httpRetries": true,
      "dbRetries": true,
      "passCancellation": false,
      "alwaysThrow": false,
      "holdMessageMs": 0,
      "disableLockRenewal": false,
      "delayedRedelivery": true,
      "maxConcurrentCalls": 1,
      "maxDeliveryCount": 10
    },
    "images": {
      "PgWeb": "docker.io/sosedoff/pgweb:0.16.2",
      "Postgres": "docker.io/library/postgres:18.3",
      "ServiceBusEmulator": "mcr.microsoft.com/azure-messaging/servicebus-emulator:2.0.0",
      "ServiceBusEmulatorSql": "mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04",
      "Toxiproxy": "ghcr.io/shopify/toxiproxy:2.13.0"
    },
    "processor": {
      "prefetchCount": 0,
      "receiveMode": 0,
      "autoCompleteMessages": true,
      "maxAutoLockRenewalDuration": "00:05:00",
      "maxConcurrentCalls": 1,
      "subQueue": 0,
      "identifier": null
    },
    "serviceBusRetry": {
      "mode": 1,
      "maxRetries": 3,
      "delay": "00:00:00.8000000",
      "maxDelay": "00:01:00",
      "tryTimeout": "00:01:00",
      "customRetryPolicy": null
    }
  },
  "ordersapi": {
    "service": "ordersapi",
    "experiment": {
      "httpRetries": true,
      "dbRetries": true,
      "passCancellation": false,
      "alwaysThrow": false,
      "holdMessageMs": 0,
      "disableLockRenewal": false,
      "delayedRedelivery": true,
      "maxConcurrentCalls": 1,
      "maxDeliveryCount": 10
    },
    "images": {
      "PgWeb": "docker.io/sosedoff/pgweb:0.16.2",
      "Postgres": "docker.io/library/postgres:18.3",
      "ServiceBusEmulator": "mcr.microsoft.com/azure-messaging/servicebus-emulator:2.0.0",
      "ServiceBusEmulatorSql": "mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04",
