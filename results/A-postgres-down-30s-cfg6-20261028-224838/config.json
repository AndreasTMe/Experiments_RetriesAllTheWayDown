  "toxiproxy": {
    "version": "{\u0022version\u0022: \u00222.13.0\u0022}",
    "proxy": {
      "name": "postgres",
      "listen": "[::]:15432",
      "upstream": "external-postgres:5432",
      "enabled": true,
      "Logger": {},
      "toxics": []
    }
